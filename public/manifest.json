{
  "manifest_version": 3,
  "name": "GeoGuessr Coach",
  "version": "0.1.0",
  "description": "A privacy-first coach for completed GeoGuessr rounds.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.geoguessr.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Open GeoGuessr Coach"
  },
  "options_page": "index.html",
  "content_scripts": [
    {
      "matches": ["https://www.geoguessr.com/*"],
      "js": ["content-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.geoguessr.com/*"],
      "js": ["collector-main.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
