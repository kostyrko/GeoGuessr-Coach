{
  "name": "geoguessr-coach",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && npm run verify:extension-csp && npm run build:extension-worker",
    "build:extension-worker": "esbuild src/extension/background.ts --bundle --format=esm --platform=browser --target=es2022 --outfile=dist/geoguessr-coach/browser/background.js",
    "verify:extension-csp": "node scripts/assert-extension-csp.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "typecheck": "tsc --project tsconfig.app.json --noEmit",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@geo-maps/countries-land-10km": "^0.6.0",
    "dexie": "^4.2.1",
    "i18n-iso-countries": "^7.14.0",
    "maplibre-gl": "^6.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.20",
    "@angular/cli": "^21.2.20",
    "@angular/compiler-cli": "^21.2.0",
    "esbuild": "^0.28.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
